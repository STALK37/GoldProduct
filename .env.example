# Copy to .env and fill in. Vite only exposes VITE_-prefixed variables to the
# browser, and only reads this file at startup — restart the dev server after
# editing it.
#
# Everything here is public. It ends up in the JavaScript bundle by design, so
# row-level security is what actually protects your data; see SECURITY.md.
# The service-role key is NOT public and must never appear in this file.

# Supabase → Project Settings → API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Your own origin, no trailing slash. Canonical links, Open Graph tags and
# JSON-LD are built from it — leave it pointing somewhere else and you hand
# that domain your search ranking.
VITE_SITE_URL="https://goldproduct.org"
